# Wallet, das die Bankroll hält. Base58 oder JSON-Array mit 64 Bytes.
# Der Bot legt für jeden Coin ein neues Wallet an und schiebt das ganze SOL dorthin.
PRIVATE_KEY=

# Schutz für die öffentliche Railway-URL. Mindestens 8 Zeichen.
DASHBOARD_PASSWORD=

# Dieselben Variablen wie im Metadatascanner-Service.
PINATA_JWT=
SOLANA_RPC_URL=
HELIUS_API_KEY=

# Railway-Volume auf /data mounten, sonst sind die Wallet-Keys nach einem Redeploy weg.
DATA_DIR=/data
PORT=8080
AUTOSTART=true
